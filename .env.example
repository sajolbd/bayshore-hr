# MongoDB Atlas Connection String (On Vercel: allow 0.0.0.0/0 in MongoDB Atlas -> Network Access)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/bayshore_hr?retryWrites=true&w=majority

# REQUIRED on Vercel & local: Secret key for signing HttpOnly JWT session cookies & encrypting SMTP password (openssl rand -hex 48)
JWT_SECRET=replace-with-strong-random-hex-secret

# Public base URL for invitation links (optional on Vercel — auto-detects https://<your-domain> from request headers)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=shamim.bayshore@gmail.com
SUPER_ADMIN_PASSWORD=change-me-in-production

# SMTP Fallback Configuration (Optional if configured inside Dashboard -> Settings -> Gmail & SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bayshore HR <noreply@bayshore.com>"
