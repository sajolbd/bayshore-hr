# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/bayshore_hr?retryWrites=true&w=majority

# Cryptographic secret for signing HttpOnly JWT session cookies (generate with: openssl rand -hex 48)
JWT_SECRET=replace-with-strong-random-hex-secret

# Public base URL for invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=shamim.bayshore@gmail.com
SUPER_ADMIN_PASSWORD=change-me-in-production

# SMTP Configuration for Real Invitation Emails (Gmail App Password / Resend / Brevo / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bayshore HR <noreply@bayshore.com>"
